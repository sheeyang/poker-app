{
  "name": "@poker/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "db:init": "node --env-file-if-exists=../../.env --import tsx src/db/init.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node ../../scripts/build-server.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/websocket": "^11.3.3",
    "@poker/contracts": "workspace:*",
    "@poker/engine": "workspace:*",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/ws": "^8.18.2"
  }
}