{
  "name": "poker-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "db:init": "pnpm --filter @poker/server db:init",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm check:boundaries"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "esbuild": "0.28.2"
  }
}